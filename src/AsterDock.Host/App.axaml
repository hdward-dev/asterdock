<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:semi="https://irihi.tech/semi"
             x:Class="AsterDock.Host.App"
             RequestedThemeVariant="Default">
  <TrayIcon.Icons>
    <TrayIcons>
      <TrayIcon ToolTipText="星栈" IsVisible="True" Clicked="TrayIcon_Clicked">
        <TrayIcon.Menu>
          <NativeMenu>
            <NativeMenuItem Header="打开星栈" Click="OpenAsterDock_Click"/>
            <NativeMenuItem Header="显示/隐藏设备监控窗" Click="ToggleDeviceWidget_Click"/>
            <NativeMenuItemSeparator/>
            <NativeMenuItem Header="退出" Click="ExitApplication_Click"/>
          </NativeMenu>
        </TrayIcon.Menu>
      </TrayIcon>
    </TrayIcons>
  </TrayIcon.Icons>
  <Application.Styles>
    <semi:SemiTheme Locale="zh-CN"/>
    <semi:UrsaSemiTheme Locale="zh-CN"/>
    <StyleInclude Source="avares://AsterDock.UI/Themes/AsterDockTheme.axaml"/>
  </Application.Styles>
</Application>
