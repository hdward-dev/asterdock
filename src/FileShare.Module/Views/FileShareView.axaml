<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:AsterDock.UI.Controls"
             x:Class="FileShareApp.Module.Views.FileShareView"
             Background="{DynamicResource AppPageBrush}">
  <Grid RowDefinitions="64,*">
    <ui:PageHeader Title="文件共享" Subtitle="让文件，在设备之间自由流动。"/>
    <ScrollViewer Grid.Row="1">
      <Grid Margin="28,22,28,28" ColumnDefinitions="1.7*,*" ColumnSpacing="18">
        <StackPanel Spacing="18">
          <Border Classes="ad-card" Padding="24" Background="{DynamicResource AppAccentSurfaceBrush}">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="8">
                <TextBlock Text="共享服务" FontSize="13" Foreground="{DynamicResource AppAccentBrush}"/>
                <TextBlock Text="{Binding StatusTitle}" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource AppStrongTextBrush}"/>
                <TextBlock Text="{Binding StatusDescription}" Foreground="{DynamicResource AppMutedBrush}"/>
                <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,8,0,0">
                  <TextBlock Text="{Binding ProtectionText}" Foreground="{DynamicResource AppMutedBrush}"/>
                  <TextBlock Text="只读下载" Foreground="{DynamicResource AppMutedBrush}"/>
                  <TextBlock Text="支持断点续传" Foreground="{DynamicResource AppMutedBrush}"/>
                </StackPanel>
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Right">
                <ToggleButton Classes="share-switch share-switch-large" IsChecked="{Binding IsRunning}"/>
                <TextBlock Text="{Binding SwitchHint}" HorizontalAlignment="Center" FontSize="12" Foreground="{DynamicResource AppMutedBrush}"/>
              </StackPanel>
            </Grid>
          </Border>

          <Border Classes="ad-card" Padding="24">
            <StackPanel Spacing="16">
              <TextBlock Text="共享设置" Classes="ad-heading"/>
              <TextBlock Text="共享目录" Foreground="{DynamicResource AppMutedBrush}"/>
              <Border Background="{DynamicResource AppSubtleBrush}" CornerRadius="10" Padding="14">
                <Grid ColumnDefinitions="*,Auto,Auto">
                  <StackPanel>
                    <TextBlock Text="{Binding DirectoryName}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Settings.Root}" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource AppMutedBrush}"/>
                  </StackPanel>
                  <Button Grid.Column="1" Classes="ad-flat" Content="更换目录" Click="ChooseDirectory"/>
                  <Button Grid.Column="2" Classes="ad-icon" Content="↗" Click="OpenDirectory"/>
                </Grid>
              </Border>
              <Grid ColumnDefinitions="Auto,120,*">
                <TextBlock Text="服务端口" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Margin="14,0" Text="{Binding PortText}" Classes="ad-compact"/>
                <TextBlock Grid.Column="2" Text="修改后需重启共享" VerticalAlignment="Center" Foreground="{DynamicResource AppMutedBrush}"/>
              </Grid>
              <Border Height="1" Background="{DynamicResource AppBorderBrush}"/>
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock Text="访问口令" FontWeight="SemiBold"/>
                  <TextBlock Text="开启后，访问共享内容需要验证口令" FontSize="12" Foreground="{DynamicResource AppMutedBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                  <TextBlock Text="{Binding PasswordToggleText}" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource AppMutedBrush}"/>
                  <ToggleButton Classes="share-switch" IsChecked="{Binding Settings.PasswordEnabled}"/>
                </StackPanel>
              </Grid>
              <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding Settings.PasswordEnabled}">
                <TextBox Text="{Binding Settings.Password}" PasswordChar="{Binding PasswordChar}" FontFamily="Consolas"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <Button Classes="ad-flat" Content="{Binding RevealText}" Click="ToggleReveal"/>
                  <Button Classes="ad-flat" Content="重新生成" Click="Regenerate"/>
                </StackPanel>
              </Grid>
              <TextBlock Text="自动生成，可直接修改为自定义口令；关闭保护后仍保留" FontSize="12" Foreground="{DynamicResource AppMutedBrush}"/>
              <Button Classes="ad-outline" Content="应用设置" HorizontalAlignment="Right" Click="Apply"/>
              <TextBlock Text="{Binding Message}" Foreground="{DynamicResource AppAccentBrush}"/>
            </StackPanel>
          </Border>
        </StackPanel>

        <Border Grid.Column="1" Classes="ad-card" Padding="24">
          <StackPanel Spacing="16">
            <TextBlock Text="连接你的设备" Classes="ad-heading"/>
            <TextBlock Text="局域网访问地址" Foreground="{DynamicResource AppMutedBrush}"/>
            <TextBlock Text="{Binding LanAddress}" FontFamily="Consolas" FontSize="26" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding PortSummary}" Foreground="{DynamicResource AppMutedBrush}"/>
            <Border Background="{DynamicResource AppSubtleBrush}" CornerRadius="10" Padding="14">
              <StackPanel Spacing="5">
                <TextBlock Text="分享链接" FontSize="12" Foreground="{DynamicResource AppMutedBrush}"/>
                <TextBlock Text="{Binding ShareUrl}" FontFamily="Consolas" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
            <Button Classes="ad-primary" Content="复制分享链接" HorizontalAlignment="Stretch" Click="CopyLink"/>
            <TextBlock Text="{Binding CopyHint}" HorizontalAlignment="Center" Foreground="{DynamicResource AppMutedBrush}"/>
            <Button Classes="ad-outline" Content="在浏览器打开" HorizontalAlignment="Stretch" Click="OpenBrowser"/>
            <Border Height="1" Background="{DynamicResource AppBorderBrush}" Margin="0,8"/>
            <TextBlock Text="两种访问方式" FontWeight="SemiBold"/>
            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="带口令链接" Foreground="{DynamicResource AppMutedBrush}"/><TextBlock Grid.Column="1" Text="直接通过验证"/></Grid>
            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="普通地址" Foreground="{DynamicResource AppMutedBrush}"/><TextBlock Grid.Column="1" Text="打开口令登录页"/></Grid>
            <TextBlock Text="关闭口令保护时，自动复制普通链接" FontSize="12" Foreground="{DynamicResource AppMutedBrush}" Margin="0,10,0,0"/>
          </StackPanel>
        </Border>
      </Grid>
    </ScrollViewer>
  </Grid>
  <UserControl.Styles>
    <Style Selector="ToggleButton.share-switch">
      <Setter Property="Width" Value="50"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="#d5d8e2"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border x:Name="Track" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" Padding="3">
            <Canvas Width="44" Height="22">
              <Border x:Name="Knob" Canvas.Left="0" Width="22" Height="22" CornerRadius="11" Background="#ffffff"
                      BoxShadow="0 1 3 0 #33000000"/>
            </Canvas>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="ToggleButton.share-switch:checked">
      <Setter Property="Background" Value="#6966d9"/>
    </Style>
    <Style Selector="ToggleButton.share-switch:checked /template/ Border#Knob">
      <Setter Property="Canvas.Left" Value="22"/>
    </Style>
    <Style Selector="ToggleButton.share-switch:pointerover">
      <Setter Property="Background" Value="#c8ccd8"/>
    </Style>
    <Style Selector="ToggleButton.share-switch:checked:pointerover">
      <Setter Property="Background" Value="#5d5acc"/>
    </Style>
    <Style Selector="ToggleButton.share-switch-large">
      <Setter Property="Width" Value="126"/>
      <Setter Property="Height" Value="66"/>
      <Setter Property="CornerRadius" Value="33"/>
    </Style>
    <Style Selector="ToggleButton.share-switch-large /template/ Border#Track">
      <Setter Property="Padding" Value="7"/>
    </Style>
    <Style Selector="ToggleButton.share-switch-large /template/ Canvas">
      <Setter Property="Width" Value="112"/>
      <Setter Property="Height" Value="52"/>
    </Style>
    <Style Selector="ToggleButton.share-switch-large /template/ Border#Knob">
      <Setter Property="Width" Value="52"/>
      <Setter Property="Height" Value="52"/>
      <Setter Property="CornerRadius" Value="26"/>
    </Style>
    <Style Selector="ToggleButton.share-switch-large:checked /template/ Border#Knob">
      <Setter Property="Canvas.Left" Value="60"/>
    </Style>
  </UserControl.Styles>
</UserControl>
