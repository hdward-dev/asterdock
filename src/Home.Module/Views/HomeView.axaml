<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:Home.Module.Models" x:Class="Home.Module.Views.HomeView"
             x:CompileBindings="False" FontFamily="Microsoft YaHei, PingFang SC, Noto Sans CJK SC, Inter" Background="{DynamicResource AppPageBrush}">
  <UserControl.Styles>
    <Style Selector="Border.home-card">
      <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/>
    </Style>
    <Style Selector="TextBlock.section-title"><Setter Property="FontSize" Value="20"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}"/></Style>
    <Style Selector="Button.home-flat">
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="12"/>
    </Style>
    <Style Selector="Button.home-flat:pointerover"><Setter Property="Background" Value="{DynamicResource AppSelectionBrush}"/></Style>
    <Style Selector="Button.home-nav"><Setter Property="Height" Value="48"/><Setter Property="Margin" Value="0,2"/></Style>
    <Style Selector="Button.home-tile">
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,14,14"/>
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="14"/><Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="Button.home-tile:pointerover Border.home-card"><Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/><Setter Property="Background" Value="{DynamicResource AppSelectionBrush}"/></Style>
    <Style Selector="ProgressBar.home-progress"><Setter Property="Height" Value="8"/><Setter Property="CornerRadius" Value="4"/><Setter Property="Background" Value="{DynamicResource AppPreviewBrush}"/></Style>
  </UserControl.Styles>
  <Grid ColumnDefinitions="192,*">
    <Border Background="{DynamicResource AppChromeBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,1,0" Padding="12,26,12,18">
      <Grid RowDefinitions="Auto,*,Auto">
        <Border CornerRadius="10" Background="{DynamicResource AppAccentSurfaceBrush}" Padding="14,13">
          <StackPanel Orientation="Horizontal" Spacing="14">
            <PathIcon Data="M3,11 L12,3 L21,11 V21 H14 V15 H10 V21 H3 Z" Width="19" Height="19" Foreground="{DynamicResource AppAccentBrush}"/>
            <TextBlock Text="主页" Foreground="{DynamicResource AppAccentBrush}" FontWeight="SemiBold"/>
          </StackPanel>
        </Border>
        <ScrollViewer Grid.Row="1" Margin="0,24,0,12" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="10">
            <TextBlock Text="应用" Classes="muted" Margin="12,0" FontSize="12"/>
            <ItemsControl ItemsSource="{Binding Applications}">
              <ItemsControl.ItemTemplate><DataTemplate x:DataType="models:HomeApplicationItem">
                <Button Classes="home-flat home-nav" Tag="{Binding}" Click="ApplicationTile_Click" ToolTip.Tip="{Binding Name}">
                  <Grid ColumnDefinitions="20,*">
                    <PathIcon Data="{Binding IconGeometry}" Foreground="{Binding IconForeground}" Width="19" Height="19"/>
                    <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                  </Grid>
                </Button>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Spacing="4">
          <Border Height="1" Background="{DynamicResource AppBorderBrush}" Margin="0,0,0,12"/>
          <Button Classes="home-flat home-nav" Content="⊞   应用管理" Click="ShowSettings_Click"/>
          <Button Classes="home-flat home-nav" Content="⚙   设置" Click="ShowSettings_Click"/>
        </StackPanel>
      </Grid>
    </Border>
    <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
      <StackPanel Margin="28" Spacing="24">
        <Grid ColumnDefinitions="*,Auto" MinHeight="72">
          <StackPanel Spacing="6" VerticalAlignment="Center">
            <TextBlock Text="欢迎回来" FontSize="30" FontWeight="Bold"/>
            <TextBlock Text="你的工具，各就其位。" Classes="muted" FontSize="16"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <TextBox Width="192" Height="42" PlaceholderText="搜索应用" Text="{Binding SearchText, Mode=TwoWay}" VerticalContentAlignment="Center" CornerRadius="9" Background="{DynamicResource AppInputBrush}" BorderBrush="{DynamicResource AppInputBorderBrush}" BorderThickness="1"/>
            <Button Classes="primary" Content="＋ 添加应用" Height="42" Padding="16,0" Click="ShowSettings_Click"/>
          </StackPanel>
        </Grid>
        <Grid ColumnDefinitions="*,24,292">
          <StackPanel Spacing="14">
            <StackPanel Orientation="Horizontal" Spacing="16">
              <TextBlock Text="常用应用" Classes="section-title"/>
              <TextBlock Text="{Binding AvailableApplicationsText}" Classes="muted" VerticalAlignment="Center" FontSize="12"/>
            </StackPanel>
            <ItemsControl ItemsSource="{Binding FilteredApplications}" Margin="0,0,-14,-14">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate><DataTemplate x:DataType="models:HomeApplicationItem">
                <Button Classes="home-tile" Tag="{Binding}" Click="ApplicationTile_Click" ToolTip.Tip="{Binding Description}">
                  <Border Classes="home-card" Padding="18" MinHeight="168">
                    <Grid RowDefinitions="56,Auto,Auto">
                      <Border Width="48" Height="48" CornerRadius="12" Background="{Binding IconBackground}" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <PathIcon Data="{Binding IconGeometry}" Foreground="{Binding IconForeground}" Width="26" Height="26"/>
                      </Border>
                      <TextBlock Text="↗" Classes="muted" HorizontalAlignment="Right" FontSize="18"/>
                      <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,6" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Grid.Row="2" Text="{Binding ShortDescription}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                  </Border>
                </Button>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Classes="home-card" Padding="24" IsVisible="{Binding HasNoSearchResults}">
              <TextBlock Text="{Binding EmptyApplicationsText}" Classes="muted" TextWrapping="Wrap"/>
            </Border>
            <TextBlock Text="最近使用" Classes="section-title" Margin="0,8,0,0"/>
            <Border Classes="home-card" Padding="10" MinHeight="154">
              <Grid>
                <TextBlock Text="打开一个应用，从这里继续工作" Classes="muted" IsVisible="{Binding !HasRecentApplications}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <ItemsControl ItemsSource="{Binding RecentApplications}" IsVisible="{Binding HasRecentApplications}">
                  <ItemsControl.ItemTemplate><DataTemplate x:DataType="models:RecentApplicationItem">
                    <Button Classes="home-flat" Tag="{Binding}" Click="RecentApplication_Click" Height="46">
                      <Grid ColumnDefinitions="30,*,Auto,22">
                        <Border Background="{Binding IconBackground}" CornerRadius="8" Width="30" Height="30">
                          <PathIcon Data="{Binding IconGeometry}" Foreground="{Binding IconForeground}" Width="17" Height="17"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="2" Text="{Binding RelativeTime}" Classes="muted" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="›" Classes="muted" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                      </Grid>
                    </Button>
                  </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
              </Grid>
            </Border>
            <Button Classes="home-flat" Background="{DynamicResource AppAccentSurfaceBrush}" Padding="18" Click="BrowseApplications_Click">
              <Grid ColumnDefinitions="36,*,Auto">
                <TextBlock Text="＋" FontSize="28" Foreground="{DynamicResource AppAccentBrush}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="扩展你的工具箱" FontWeight="SemiBold"/><TextBlock Text="发现更多轻应用" Classes="muted" FontSize="12"/></StackPanel>
                <TextBlock Grid.Column="2" Text="浏览应用 →" Foreground="{DynamicResource AppAccentBrush}" VerticalAlignment="Center"/>
              </Grid>
            </Button>
          </StackPanel>
          <StackPanel Grid.Column="2" Spacing="20" Margin="0,44,0,0">
            <Border Classes="home-card" Padding="20">
              <StackPanel Spacing="26">
                <Grid ColumnDefinitions="*,Auto"><TextBlock Text="设备概览" Classes="section-title"/><TextBlock Grid.Column="1" Text="{Binding MetricsStatus}" Classes="muted" FontSize="11" VerticalAlignment="Center"/></Grid>
                <StackPanel Spacing="10">
                  <Grid ColumnDefinitions="*,Auto"><TextBlock Text="CPU"/><TextBlock Grid.Column="1" Text="{Binding CpuUsageText}"/></Grid>
                  <ProgressBar Classes="home-progress" Value="{Binding CpuUsage}" Foreground="#3474F5"/>
                </StackPanel>
                <StackPanel Spacing="10">
                  <Grid ColumnDefinitions="*,Auto"><TextBlock Text="GPU"/><TextBlock Grid.Column="1" Text="{Binding GpuUsageText}"/></Grid>
                  <ProgressBar Classes="home-progress" Value="{Binding GpuUsage}" Foreground="#9556E9"/>
                </StackPanel>
                <StackPanel Spacing="10">
                  <Grid ColumnDefinitions="*,Auto"><TextBlock Text="内存"/><TextBlock Grid.Column="1" Text="{Binding MemoryUsageText}"/></Grid>
                  <ProgressBar Classes="home-progress" Value="{Binding MemoryUsage}" Foreground="#25BFA9"/>
                </StackPanel>
                <Border Height="1" Background="{DynamicResource AppBorderBrush}"/>
                <Button Classes="home-flat" Content="查看设备详情 →" Foreground="{DynamicResource AppAccentBrush}" HorizontalContentAlignment="Right" Padding="0" Click="OpenDeviceInformation_Click"/>
              </StackPanel>
            </Border>
            <Border Classes="home-card" Padding="16">
              <StackPanel Spacing="10">
                <TextBlock Text="快捷操作" Classes="section-title" Margin="4,2,0,8"/>
                <Button Classes="home-flat" Click="ShowApplicationSwitcher_Click" Height="48">
                  <Grid ColumnDefinitions="*,Auto"><TextBlock Text="⊞  应用选择" VerticalAlignment="Center"/><Border Grid.Column="1" CornerRadius="5" Background="{DynamicResource AppSubtleBrush}" Padding="6,4"><TextBlock Text="Space + A" FontSize="11"/></Border></Grid>
                </Button>
                <Button Classes="home-flat" Content="▣  显示 / 隐藏设备监控窗  ›" Click="ToggleDeviceWidget_Click" Height="48" FontSize="12"/>
                <Button Classes="home-flat" Content="⚙  打开设置  ›" Click="ShowSettings_Click" Height="48"/>
              </StackPanel>
            </Border>
            <TextBlock Text="⊞  让日常操作更简单" Classes="muted" HorizontalAlignment="Center" FontSize="12" Margin="0,10"/>
          </StackPanel>
        </Grid>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
