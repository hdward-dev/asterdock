<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NetworkAccelerator.Module.Views.LogWindow"
        x:CompileBindings="False" Title="运行日志" Width="720" Height="460"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppPageBrush}">
  <Grid RowDefinitions="58,*">
    <Border Background="{DynamicResource AppChromeBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1">
      <TextBlock Text="sing-box 运行日志" FontSize="19" FontWeight="SemiBold" Margin="22,0" VerticalAlignment="Center"/>
    </Border>
    <TextBox Grid.Row="1" x:Name="LogTextBox" Margin="20" IsReadOnly="True" AcceptsReturn="True"
             TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
  </Grid>
</Window>
