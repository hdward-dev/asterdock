<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:NetworkAccelerator.Module.Models"
             xmlns:views="using:NetworkAccelerator.Module.Views"
             xmlns:controls="using:NetworkAccelerator.Module.Controls"
             x:Class="NetworkAccelerator.Module.Views.NetworkAcceleratorView"
             x:CompileBindings="False" Background="{DynamicResource AppPageBrush}">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://NetworkAccelerator.Module/Themes/NetworkAcceleratorIcons.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="Button">
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.mode">
      <Setter Property="Height" Value="40"/>
      <Setter Property="Padding" Value="20,0"/>
      <Setter Property="CornerRadius" Value="7"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.mode.selected">
      <Setter Property="Foreground" Value="{DynamicResource AppOnAccentBrush}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button.mode:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.mode:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.node-row">
      <Setter Property="Height" Value="72"/>
      <Setter Property="Padding" Value="14,0"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="9"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Stretch"/>
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.node-row.selected">
      <Setter Property="Background" Value="{DynamicResource AppSelectionBrush}"/>
    </Style>
    <Style Selector="ItemsControl.node-list > ContentPresenter">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="TextBox.node-search">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="Padding" Value="13,0"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Background" Value="{DynamicResource AppInputBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AppInputBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="9"/>
      <Setter Property="SelectionBrush" Value="{DynamicResource AppSelectionBrush}"/>
    </Style>
    <Style Selector="TextBox.node-search:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource AppInputHoverBorderBrush}"/>
    </Style>
    <Style Selector="TextBox.node-search:focus">
      <Setter Property="BorderBrush" Value="{DynamicResource AppFocusBrush}"/>
      <Setter Property="BorderThickness" Value="2"/>
    </Style>
    <Style Selector="TextBlock.latency-value">
      <Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}"/>
    </Style>
    <Style Selector="TextBlock.latency-value.measured">
      <Setter Property="Foreground" Value="{DynamicResource AppPositiveBrush}"/>
    </Style>
    <Style Selector="TextBlock.latency-value.slow">
      <Setter Property="Foreground" Value="{DynamicResource AppWarningBrush}"/>
    </Style>
    <Style Selector="Border.connection-state">
      <Setter Property="Background" Value="{DynamicResource AppMutedBrush}"/>
    </Style>
    <Style Selector="Border.connection-state.connected">
      <Setter Property="Background" Value="{DynamicResource AppPositiveBrush}"/>
    </Style>
    <Style Selector="TextBlock.connection-state">
      <Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}"/>
    </Style>
    <Style Selector="TextBlock.connection-state.connected">
      <Setter Property="Foreground" Value="{DynamicResource AppPositiveBrush}"/>
    </Style>
    <Style Selector="TextBlock.core-state">
      <Setter Property="Foreground" Value="{DynamicResource AppWarningBrush}"/>
    </Style>
    <Style Selector="TextBlock.core-state.ready">
      <Setter Property="Foreground" Value="{DynamicResource AppPositiveBrush}"/>
    </Style>
    <Style Selector="PathIcon.core-state">
      <Setter Property="Foreground" Value="{DynamicResource AppWarningBrush}"/>
    </Style>
    <Style Selector="PathIcon.core-state.ready">
      <Setter Property="Foreground" Value="{DynamicResource AppPositiveBrush}"/>
    </Style>
    <Style Selector="Path.latency-spinner">
      <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
      <Style.Animations>
        <Animation Duration="0:0:0.75" IterationCount="Infinite">
          <KeyFrame Cue="0%">
            <Setter Property="RotateTransform.Angle" Value="0"/>
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="RotateTransform.Angle" Value="360"/>
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Button.section-nav">
      <Setter Property="Height" Value="68"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="Padding" Value="8"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}"/>
      <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
      <Setter Property="RenderTransform" Value="scale(1)"/>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Foreground" Duration="0:0:0.15"/>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.section-nav.selected">
      <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button.section-nav:pressed, Button.section-nav.down">
      <Setter Property="RenderTransform" Value="scale(0.96)"/>
    </Style>
    <Style Selector="Button.section-nav:pointerover /template/ ContentPresenter,
                     Button.section-nav:pressed /template/ ContentPresenter,
                     Button.section-nav.down /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="UserControl.still Button.section-nav">
      <Setter Property="Transitions" Value="{x:Null}"/>
    </Style>
    <Style Selector="TextBlock.page-title">
      <Setter Property="FontSize" Value="21"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="TextBlock.description">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="*,88">
    <ScrollViewer x:Name="PageScroll" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
      <StackPanel Margin="24" Spacing="20">
        <StackPanel Spacing="5">
          <TextBlock x:Name="SectionTitle" Classes="page-title" Text="概览"/>
          <TextBlock x:Name="SectionDescription" Classes="description" Text="连接状态与常用功能，一目了然"/>
        </StackPanel>
        <Border x:Name="PageStatus" Background="{DynamicResource AppSubtleBrush}" CornerRadius="10" Padding="14,10" IsVisible="False">
          <StackPanel Spacing="8">
            <TextBlock Text="{Binding StatusMessage}" Classes="description"/>
            <ProgressBar IsVisible="{Binding IsBusy}" IsIndeterminate="True" Height="3"/>
          </StackPanel>
        </Border>
        <Grid x:Name="PageHost">
        <views:OverviewDashboardView x:Name="OverviewPage" VerticalAlignment="Top"/>
        <StackPanel x:Name="ConnectionsWrap" Spacing="20" IsVisible="False" VerticalAlignment="Top">
        <Border x:Name="ConnectionCard" Classes="card" Padding="24" CornerRadius="16">
          <StackPanel Spacing="20">
            <Grid x:Name="ConnectionHeader" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
              <Grid ColumnDefinitions="56,*" Margin="0,0,16,0">
                <Border Width="44" Height="44" CornerRadius="14" Background="{DynamicResource AppAccentSurfaceBrush}" VerticalAlignment="Top">
                  <PathIcon Data="{StaticResource RiFlashlightLine}" Width="22" Height="22" Foreground="{DynamicResource AppAccentBrush}"/>
                </Border>
                <StackPanel Grid.Column="1" Spacing="6">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding ConnectionStatusText}" FontSize="24" FontWeight="SemiBold"/>
                    <Border Classes="connection-state" Classes.connected="{Binding IsConnected}" Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center"/>
                  </StackPanel>
                  <TextBlock Text="{Binding StatusMessage}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource AppMutedBrush}"/>
                </StackPanel>
              </Grid>
              <Button x:Name="ConnectionAction" Grid.Column="1" Classes="accent" Content="{Binding ConnectionButtonText}"
                      MinWidth="148" Height="48" Padding="24,0" CornerRadius="12" VerticalAlignment="Center"
                      IsEnabled="{Binding !IsBusy}" Click="ToggleConnection_Click"/>
            </Grid>
            <ProgressBar IsVisible="{Binding IsBusy}" IsIndeterminate="True" Height="3"/>
            <Border Background="{DynamicResource AppSubtleBrush}" CornerRadius="12" Padding="18,14">
              <Grid x:Name="ConnectionMetrics" ColumnDefinitions="2*,*,*,*" RowDefinitions="Auto,Auto">
                <StackPanel x:Name="NodeMetric" Spacing="6" Margin="0,0,16,0">
                  <TextBlock Text="当前线路" FontSize="11" Foreground="{DynamicResource AppMutedBrush}"/>
                  <TextBlock Text="{Binding CurrentNodeText}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding CurrentNodeText}"/>
                </StackPanel>
                <StackPanel x:Name="LatencyMetric" Grid.Column="1" Spacing="6">
                  <TextBlock Text="线路延迟" FontSize="11" Foreground="{DynamicResource AppMutedBrush}"/>
                  <TextBlock Text="{Binding CurrentLatencyText}" FontSize="17" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel x:Name="DurationMetric" Grid.Column="2" Spacing="6">
                  <TextBlock Text="连接时长" FontSize="11" Foreground="{DynamicResource AppMutedBrush}"/>
                  <TextBlock Text="{Binding ConnectionDurationText}" FontSize="17" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel x:Name="PortMetric" Grid.Column="3" Spacing="3">
                  <TextBlock Text="本地代理端口" FontSize="11" Foreground="{DynamicResource AppMutedBrush}"/>
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding ProxyPort}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button Width="26" Height="26" Padding="0" Background="Transparent" BorderThickness="0"
                            AutomationProperties.Name="复制终端代理命令" ToolTip.Tip="复制终端代理命令" Click="CopyTerminalProxyCommand_Click">
                      <PathIcon Data="{StaticResource RiFileCopyLine}" Width="16" Height="16" Foreground="{DynamicResource AppAccentBrush}"/>
                    </Button>
                  </StackPanel>
                </StackPanel>
              </Grid>
            </Border>
          </StackPanel>
        </Border>
        <Border x:Name="ConnectionsPage" Classes="card" Padding="24" CornerRadius="16">
          <StackPanel Spacing="18">
            <TextBlock Text="本地连接" FontSize="17" FontWeight="SemiBold"/>
            <TextBlock Classes="description" Text="查看当前代理入口，或复制命令供终端使用。"/>
            <Grid ColumnDefinitions="140,*"><TextBlock Classes="description" Text="监听地址"/><TextBlock Grid.Column="1" Text="127.0.0.1"/></Grid>
            <Grid ColumnDefinitions="140,*"><TextBlock Classes="description" Text="HTTP / SOCKS 端口"/><TextBlock Grid.Column="1" Text="{Binding ProxyPort}"/></Grid>
            <Grid ColumnDefinitions="140,*"><TextBlock Classes="description" Text="接入方式"/><TextBlock Grid.Column="1" Text="{Binding ConnectionMethodText}"/></Grid>
            <TextBlock Classes="description" Text="{Binding ModeDescription}"/>
            <Button Content="复制终端代理命令" Click="CopyTerminalProxyCommand_Click"/>
          </StackPanel>
        </Border>
        </StackPanel>

        <StackPanel x:Name="RulesPage" Spacing="16" IsVisible="False" VerticalAlignment="Top">
          <Border Classes="card" Padding="24" CornerRadius="16">
            <StackPanel Spacing="14">
              <TextBlock Text="当前路由策略" FontSize="17" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding RulesText}" Foreground="{DynamicResource AppAccentBrush}"/>
              <TextBlock Classes="description" Text="{Binding ModeDescription}"/>
              <Button Content="切换代理方式" Tag="Proxies" Click="Navigate_Click"/>
            </StackPanel>
          </Border>
          <Border Classes="card" Padding="24" CornerRadius="16">
            <StackPanel Spacing="18">
              <TextBlock Text="内置分流规则" FontSize="17" FontWeight="SemiBold"/>
              <TextBlock Classes="description" Text="以下为应用生成的路由规则；规则集在规则模式下启用。"/>
              <Border Background="{DynamicResource AppSubtleBrush}" CornerRadius="10" Padding="16"><StackPanel Spacing="6"><TextBlock Text="本机与局域网 · 直连" FontWeight="SemiBold"/><TextBlock Classes="description" Text="本机、私有地址和链路本地地址直接连接。"/></StackPanel></Border>
              <Border Background="{DynamicResource AppSubtleBrush}" CornerRadius="10" Padding="16"><StackPanel Spacing="6"><TextBlock Text="geosite-cn / geoip-cn" FontWeight="SemiBold"/><TextBlock Classes="description" Text="规则模式下，中国大陆域名与 IP 地址直连。"/></StackPanel></Border>
              <Border Background="{DynamicResource AppSubtleBrush}" CornerRadius="10" Padding="16"><StackPanel Spacing="6"><TextBlock Text="其他流量" FontWeight="SemiBold"/><TextBlock Classes="description" Text="规则和全局模式通过当前节点；直连模式直接连接。"/></StackPanel></Border>
            </StackPanel>
          </Border>
        </StackPanel>

        <Border x:Name="LogsPage" Classes="card" Padding="20" CornerRadius="16" IsVisible="False" VerticalAlignment="Top">
          <Grid RowDefinitions="Auto,Auto,*">
            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="运行日志" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Grid.Column="1" Content="清空显示" Click="ClearLogs_Click"/></Grid>
            <TextBlock Grid.Row="1" Classes="description" Text="本次会话最近 300 条日志，随核心运行实时更新。" Margin="0,10,0,16"/>
            <Grid Grid.Row="2" MinHeight="360">
              <TextBlock Text="暂无运行日志，启动加速后将在这里显示" Classes="description" IsVisible="{Binding HasNoLogs}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <ScrollViewer MaxHeight="560" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding LogEntries}">
                  <ItemsControl.ItemTemplate><DataTemplate><SelectableTextBlock Text="{Binding}" FontFamily="Menlo,Consolas" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </Grid>
        </Border>
        <Grid x:Name="ProxiesPage" ColumnDefinitions="*,20,300" RowDefinitions="Auto,Auto" IsVisible="False" VerticalAlignment="Top">
          <Border x:Name="NodesCard" Classes="card" Padding="20" CornerRadius="16" VerticalAlignment="Top">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="4">
                  <TextBlock Text="选择线路" FontSize="18" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding NodeCountText}" FontSize="12" Foreground="{DynamicResource AppMutedBrush}"/>
                </StackPanel>
                <Button Grid.Column="1" Content="{Binding RefreshLatencyButtonText}" Height="36" Padding="14,0" CornerRadius="8"
                        IsEnabled="{Binding CanRefreshLatencies}" Click="RefreshLatency_Click"/>
              </Grid>
              <TextBox Grid.Row="1" Classes="node-search" Margin="0,18,0,14" PlaceholderText="搜索节点名称、地区或协议"
                       AutomationProperties.Name="搜索线路" Text="{Binding NodeSearchText, Mode=TwoWay}"/>
              <Border Grid.Row="2" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="14,0,14,10">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="线路 / 协议" FontSize="11" Foreground="{DynamicResource AppMutedBrush}"/>
                  <TextBlock Grid.Column="1" Text="延迟 / 选择" FontSize="11" Foreground="{DynamicResource AppMutedBrush}"/>
                </Grid>
              </Border>
              <Grid Grid.Row="3" MinHeight="300" Margin="0,8,0,0">
                <StackPanel IsVisible="{Binding HasNoNodes}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="280">
                  <Border Width="56" Height="56" CornerRadius="18" Background="{DynamicResource AppAccentSurfaceBrush}" HorizontalAlignment="Center">
                    <PathIcon Data="{StaticResource RiAddLine}" Width="22" Height="22" Foreground="{DynamicResource AppAccentBrush}"/>
                  </Border>
                  <TextBlock Text="添加你的第一条线路" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                  <TextBlock Text="添加订阅后，即可选择节点并开始加速。" TextWrapping="Wrap" TextAlignment="Center" FontSize="12" Foreground="{DynamicResource AppMutedBrush}"/>
                  <Button Content="添加订阅" HorizontalAlignment="Center" Click="ManageSubscription_Click"/>
                </StackPanel>
                <StackPanel IsVisible="{Binding HasNoSearchResults}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                  <TextBlock Text="没有找到匹配的线路" FontSize="16" FontWeight="SemiBold"/>
                  <TextBlock Text="试试其他名称、地区或协议" FontSize="12" Foreground="{DynamicResource AppMutedBrush}" HorizontalAlignment="Center"/>
                  <Button Content="清空搜索" HorizontalAlignment="Center" Click="ClearSearch_Click"/>
                </StackPanel>
                <ScrollViewer IsVisible="{Binding HasVisibleNodes}" MaxHeight="520" VerticalScrollBarVisibility="Auto">
                  <ItemsControl Classes="node-list" ItemsSource="{Binding Nodes}" HorizontalAlignment="Stretch">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="models:NodeItemViewModel">
                        <Button Classes="node-row" Classes.selected="{Binding IsSelected}" Tag="{Binding}"
                                IsVisible="{Binding IsVisible}" Click="Node_Click">
                          <Grid ColumnDefinitions="48,*,96,30">
                            <Border Width="38" Height="38" CornerRadius="9" Background="{DynamicResource AppAccentSurfaceBrush}">
                              <Grid>
                                <PathIcon Data="{StaticResource RiFlashlightLine}" Width="18" Height="18"
                                          Foreground="{DynamicResource AppAccentBrush}" IsVisible="{Binding IsAutomatic}"/>
                                <TextBlock Text="{Binding LocationMark}" Foreground="{DynamicResource AppAccentBrush}" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           IsVisible="{Binding !IsAutomatic}"/>
                              </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                              <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                              <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource AppMutedBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Border Grid.Column="2" MinWidth="72" Height="28" Padding="9,0" CornerRadius="14"
                                    Background="{DynamicResource AppSubtleBrush}" HorizontalAlignment="Right" VerticalAlignment="Center">
                              <Grid>
                                <TextBlock Classes="latency-value"
                                           Classes.measured="{Binding HasLatency}" Classes.slow="{Binding IsSlowLatency}"
                                           Text="{Binding LatencyText}"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"
                                           IsVisible="{Binding !IsMeasuringLatency}"/>
                                <Path Classes="latency-spinner"
                                      Data="M 8,1 A 7,7 0 1 1 1,8"
                                      Width="16" Height="16" Fill="Transparent"
                                      Stroke="{DynamicResource AppAccentBrush}" StrokeThickness="2"
                                      VerticalAlignment="Center" HorizontalAlignment="Center"
                                      IsVisible="{Binding IsMeasuringLatency}">
                                  <Path.RenderTransform>
                                    <RotateTransform/>
                                  </Path.RenderTransform>
                                </Path>
                              </Grid>
                            </Border>
                            <Border Grid.Column="3" Width="18" Height="18" CornerRadius="9" BorderBrush="{DynamicResource AppControlBorderBrush}"
                                    BorderThickness="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                              <Border Width="10" Height="10" CornerRadius="5" Background="{DynamicResource AppAccentBrush}" IsVisible="{Binding IsSelected}"/>
                            </Border>
                          </Grid>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Grid>
            </Grid>
          </Border>

          <StackPanel x:Name="ProxiesSide" Grid.Column="2"/>
        </Grid>
        <StackPanel x:Name="SettingsPage" Spacing="16" IsVisible="False" VerticalAlignment="Top">
            <Border x:Name="ProxySettingsCard" Classes="card" Padding="20" CornerRadius="16">
              <StackPanel Spacing="14">
                <TextBlock Text="连接设置" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="代理方式" FontSize="12" Foreground="{DynamicResource AppMutedBrush}"/>
              <Border Background="{DynamicResource AppSubtleBrush}" CornerRadius="9" Padding="3">
                <Grid x:Name="ModeSliderHost" Height="40">
                  <Border x:Name="ModeSliderThumb" Height="40" HorizontalAlignment="Left"
                          CornerRadius="7" Background="{DynamicResource AppAccentBrush}" IsHitTestVisible="False">
                    <Border.Transitions>
                      <Transitions>
                        <DoubleTransition Property="Width" Duration="0:0:0.2"/>
                      </Transitions>
                    </Border.Transitions>
                    <Border.RenderTransform>
                      <TranslateTransform>
                        <TranslateTransform.Transitions>
                          <Transitions>
                            <DoubleTransition Property="X" Duration="0:0:0.24"/>
                          </Transitions>
                        </TranslateTransform.Transitions>
                      </TranslateTransform>
                    </Border.RenderTransform>
                  </Border>
                  <UniformGrid Columns="3" IsEnabled="{Binding !IsBusy}">
                    <Button x:Name="RuleModeButton" Classes="mode selected" Content="规则" Click="RuleMode_Click"/>
                    <Button x:Name="GlobalModeButton" Classes="mode" Content="全局" Click="GlobalMode_Click"/>
                    <Button x:Name="DirectModeButton" Classes="mode" Content="直连" Click="DirectMode_Click"/>
                  </UniformGrid>
                </Grid>
              </Border>

                <TextBlock Text="{Binding ModeDescription}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource AppMutedBrush}" MinHeight="34"/>
                <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="5">
                      <TextBlock Text="TUN 模式" FontSize="14" FontWeight="SemiBold"/>
                      <TextBlock Text="接管系统网络流量" FontSize="12" Foreground="{DynamicResource AppMutedBrush}"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" x:Name="TunToggle" IsChecked="{Binding TunEnabled}" IsEnabled="{Binding !IsBusy}"
                                  AutomationProperties.Name="TUN 模式" OnContent="" OffContent="" VerticalAlignment="Center" Click="TunToggle_Click"/>
                  </Grid>
                </Border>
                <TextBlock Text="开启后，开始加速时将请求管理员权限" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource AppWarningBrush}" IsVisible="{Binding TunRequiresAdministrator}"/>
              </StackPanel>
            </Border>
            <Border x:Name="CoreCard" Classes="card" Padding="20" CornerRadius="16">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="core-state" Classes.ready="{Binding IsCoreAvailable}" Text="{Binding CoreStatusText}"
                             FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"/>
                  <Button Grid.Column="1" Content="安装核心" IsVisible="{Binding IsCoreMissing}" IsEnabled="{Binding !IsBusy}" Padding="10,4" Click="InstallCore_Click"/>
                </Grid>
                <TextBlock Text="{Binding RulesText}" FontSize="11" Foreground="{DynamicResource AppMutedBrush}"/>
                <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="4">
                      <TextBlock Text="减少动画" FontSize="14" FontWeight="SemiBold"/>
                      <TextBlock Text="关闭卡片、数字和列表的过渡" FontSize="12" Foreground="{DynamicResource AppMutedBrush}"/>
                    </StackPanel>
                    <controls:AccentSwitch Grid.Column="1" x:Name="ReduceMotionSwitch" VerticalAlignment="Center"
                                           IsChecked="{Binding ReduceMotion}" AutomationProperties.Name="减少动画"
                                           Click="ReduceMotion_Click"/>
                  </Grid>
                </Border>
              </StackPanel>
            </Border>
        </StackPanel>
        <Border x:Name="SubscriptionCard" Classes="card" Padding="20" CornerRadius="16" IsVisible="False" VerticalAlignment="Top">
              <StackPanel Spacing="14">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="我的订阅" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  <Button Grid.Column="1" Content="管理" Padding="10,5" Background="Transparent" Click="ManageSubscription_Click" IsEnabled="{Binding !IsBusy}"/>
                </Grid>
                <ComboBox Height="36"
                          HorizontalAlignment="Stretch" Background="{DynamicResource AppInputBrush}"
                          BorderThickness="1" Padding="10,0,6,0"
                          ItemsSource="{Binding Configurations}"
                          SelectedItem="{Binding ActiveConfiguration, Mode=OneWay}"
                          PlaceholderText="选择订阅配置" IsEnabled="{Binding !IsBusy}"
                          SelectionChanged="Configuration_SelectionChanged" ToolTip.Tip="切换当前配置">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <StackPanel Spacing="5">
                  <TextBlock Text="{Binding SubscriptionName}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding SubscriptionUpdatedText}" FontSize="11" Foreground="{DynamicResource AppMutedBrush}"/>
                </StackPanel>
                <Border Background="{DynamicResource AppSubtleBrush}" CornerRadius="10" Padding="14">
                  <StackPanel Spacing="8">
                    <TextBlock Text="剩余 / 总流量" FontSize="11" Foreground="{DynamicResource AppMutedBrush}"/>
                    <TextBlock Text="{Binding RemainingTrafficText}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <ProgressBar Value="{Binding RemainingTrafficPercent}" IsVisible="{Binding HasTrafficInformation}" Height="5"/>
                  </StackPanel>
                </Border>
                <Grid ColumnDefinitions="Auto,*">
                  <TextBlock Text="到期时间" FontSize="12" Foreground="{DynamicResource AppMutedBrush}"/>
                  <TextBlock Grid.Column="1" Text="{Binding ExpiresText}" FontSize="12" HorizontalAlignment="Right"/>
                </Grid>
                <Button Content="更新订阅" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="36"
                        IsEnabled="{Binding !IsBusy}" Click="UpdateSubscription_Click"/>
              </StackPanel>
        </Border>
        </Grid>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Column="1" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1,0,0,0">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="10,24">
          <Border x:Name="NavPill" Height="68" CornerRadius="12"
                  Background="{DynamicResource AppAccentSurfaceBrush}"
                  HorizontalAlignment="Stretch" VerticalAlignment="Top" IsHitTestVisible="False">
            <Border.RenderTransform>
              <TranslateTransform/>
            </Border.RenderTransform>
          </Border>
          <StackPanel x:Name="SectionNavigation" Spacing="8">
          <Button Classes="section-nav" Tag="Overview" Click="Navigate_Click" AutomationProperties.Name="概览" ToolTip.Tip="概览">
            <StackPanel Spacing="7"><Path Data="{StaticResource RiDashboard3Line}" Width="22" Height="22" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" HorizontalAlignment="Center"/><TextBlock Text="概览" FontSize="12" HorizontalAlignment="Center"/></StackPanel>
          </Button>
          <Button Classes="section-nav" Tag="Proxies" Click="Navigate_Click" AutomationProperties.Name="代理" ToolTip.Tip="代理">
            <StackPanel Spacing="7"><Path Data="{StaticResource RiFlashlightLine}" Width="22" Height="22" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" HorizontalAlignment="Center"/><TextBlock Text="代理" FontSize="12" HorizontalAlignment="Center"/></StackPanel>
          </Button>
          <Button Classes="section-nav" Tag="Configuration" Click="Navigate_Click" AutomationProperties.Name="配置" ToolTip.Tip="配置">
            <StackPanel Spacing="7"><Path Data="{StaticResource RiFileList3Line}" Width="22" Height="22" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" HorizontalAlignment="Center"/><TextBlock Text="配置" FontSize="12" HorizontalAlignment="Center"/></StackPanel>
          </Button>
          <Button Classes="section-nav" Tag="Connections" Click="Navigate_Click" AutomationProperties.Name="连接" ToolTip.Tip="连接">
            <StackPanel Spacing="7"><Path Data="{StaticResource RiLink}" Width="22" Height="22" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" HorizontalAlignment="Center"/><TextBlock Text="连接" FontSize="12" HorizontalAlignment="Center"/></StackPanel>
          </Button>
          <Button Classes="section-nav" Tag="Rules" Click="Navigate_Click" AutomationProperties.Name="规则" ToolTip.Tip="规则">
            <StackPanel Spacing="7"><Path Data="{StaticResource RiListCheck}" Width="22" Height="22" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" HorizontalAlignment="Center"/><TextBlock Text="规则" FontSize="12" HorizontalAlignment="Center"/></StackPanel>
          </Button>
          <Button Classes="section-nav" Tag="Logs" Click="Navigate_Click" AutomationProperties.Name="日志" ToolTip.Tip="日志">
            <StackPanel Spacing="7"><Path Data="{StaticResource RiTerminalBoxLine}" Width="22" Height="22" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" HorizontalAlignment="Center"/><TextBlock Text="日志" FontSize="12" HorizontalAlignment="Center"/></StackPanel>
          </Button>
          <Button Classes="section-nav" Tag="Settings" Click="Navigate_Click" AutomationProperties.Name="设置" ToolTip.Tip="设置">
            <StackPanel Spacing="7"><Path Data="{StaticResource RiEqualizerLine}" Width="22" Height="22" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" HorizontalAlignment="Center"/><TextBlock Text="设置" FontSize="12" HorizontalAlignment="Center"/></StackPanel>
          </Button>
          </StackPanel>
        </Grid>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
