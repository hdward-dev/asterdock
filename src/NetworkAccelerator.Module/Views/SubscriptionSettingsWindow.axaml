<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NetworkAccelerator.Module.Views.SubscriptionSettingsWindow"
        x:CompileBindings="False"
        Title="配置管理" Width="760" Height="440" MinWidth="680" MinHeight="400"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppPageBrush}">
  <Window.Styles>
    <Style Selector="TextBox.modernInput">
      <Setter Property="Height" Value="42"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Background" Value="{DynamicResource AppInputBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AppInputBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="SelectionBrush" Value="{DynamicResource AppSelectionBrush}"/>
    </Style>
    <Style Selector="TextBox.modernInput:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource AppInputHoverBorderBrush}"/>
    </Style>
    <Style Selector="TextBox.modernInput:focus">
      <Setter Property="BorderBrush" Value="{DynamicResource AppFocusBrush}"/>
      <Setter Property="BorderThickness" Value="2"/>
    </Style>
  </Window.Styles>

  <Grid x:Name="WindowRootGrid" RowDefinitions="40,64,*,68">
    <Border x:Name="CustomTitleBar" Background="{DynamicResource AppChromeBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1"
            PointerPressed="TitleBar_PointerPressed">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Margin="14,0" VerticalAlignment="Center" Spacing="7">
          <Border Width="22" Height="22" CornerRadius="5" Background="{DynamicResource AppAccentBrush}">
            <PathIcon Data="M4,4 H10 V10 H4 Z M14,4 H20 V10 H14 Z M4,14 H10 V20 H4 Z M14,14 H20 V20 H14 Z"
                      Foreground="{DynamicResource AppOnAccentBrush}" Width="15" Height="15"/>
          </Border>
          <TextBlock Text="网络加速 · 配置管理" FontSize="12.5" Foreground="{DynamicResource AppStrongTextBrush}" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Classes="ad-caption" ToolTip.Tip="最小化" Click="Minimize_Click">
            <Border Width="14" Height="1.5" Margin="0,7,0,0" VerticalAlignment="Center"
                    Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
          </Button>
          <Button x:Name="MaximizeButton" Classes="ad-caption" ToolTip.Tip="最大化" Click="Maximize_Click">
            <Path x:Name="MaximizeIcon" Data="M6,6 L18,6 L18,18 L6,18 Z"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeThickness="1.25" Width="13" Height="13" Stretch="Uniform"/>
          </Button>
          <Button Classes="ad-caption close" ToolTip.Tip="关闭" Click="CloseTitleBar_Click">
            <Path Data="M6,6 L18,18 M18,6 L6,18"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeThickness="1.25" Width="13" Height="13" Stretch="Uniform"/>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1" Background="{DynamicResource AppChromeBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1">
      <StackPanel Margin="24,0" VerticalAlignment="Center">
        <TextBlock Text="配置管理" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock Text="保存多份订阅，并选择当前使用的配置" FontSize="12" Foreground="{DynamicResource AppMutedBrush}"/>
      </StackPanel>
    </Border>

    <Grid Grid.Row="2" Margin="24,20" ColumnDefinitions="220,1,*">
      <Grid RowDefinitions="Auto,*,Auto">
        <TextBlock Text="已保存的配置" FontWeight="SemiBold" Margin="4,0,0,10"/>
        <ListBox Grid.Row="1" x:Name="ConfigurationList" ItemsSource="{Binding Configurations}"
                 SelectedItem="{Binding SelectedConfiguration}" SelectionChanged="ConfigurationList_SelectionChanged">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="*,Auto" Margin="4,5">
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <Border Grid.Column="1" Background="{DynamicResource AppPositiveSurfaceBrush}" CornerRadius="8" Padding="7,2"
                        IsVisible="{Binding IsActive}">
                  <TextBlock Text="当前" FontSize="11" Foreground="{DynamicResource AppPositiveBrush}"/>
                </Border>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <Grid Grid.Row="2" ColumnDefinitions="*,8,*" Margin="0,10,0,0">
          <Button Content="添加" Click="Add_Click"/>
          <Button Grid.Column="2" Content="删除" Click="Delete_Click"/>
        </Grid>
      </Grid>

      <Border Grid.Column="1" Background="{DynamicResource AppBorderBrush}"/>

      <StackPanel Grid.Column="2" Margin="24,0,0,0" Spacing="9">
        <TextBlock Text="配置名称" FontWeight="SemiBold"/>
        <TextBox Classes="modernInput"
                 Text="{Binding SelectedConfiguration.Name, Mode=TwoWay}"
                 PlaceholderText="例如：公司网络、个人订阅"/>
        <TextBlock Text="订阅地址" FontWeight="SemiBold" Margin="0,9,0,0"/>
        <TextBox Classes="modernInput"
                 Text="{Binding SelectedConfiguration.Source, Mode=TwoWay}"
                 PlaceholderText="https://example.com/subscription 或本地文件路径"
                 TextWrapping="NoWrap"/>
        <TextBlock Text="切换配置后会载入各自缓存的节点和上次选择的节点；连接中切换会自动重启。"
                   FontSize="12" Foreground="{DynamicResource AppMutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
        <CheckBox Content="保存后切换到此配置" IsChecked="{Binding SelectedConfiguration.IsActive, Mode=TwoWay}"
                  Click="ActiveConfiguration_Click" Margin="0,8,0,0"/>
        <TextBlock x:Name="ValidationText" Foreground="{DynamicResource AppDangerBrush}" IsVisible="False" TextWrapping="Wrap"/>
      </StackPanel>
    </Grid>

    <Border Grid.Row="3" Background="{DynamicResource AppChromeBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="24,0" Spacing="10">
        <Button Content="取消" MinWidth="88" Click="Cancel_Click"/>
        <Button Classes="accent" Content="保存配置" MinWidth="112" Click="Save_Click"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
