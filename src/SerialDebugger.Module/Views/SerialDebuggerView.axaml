<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="using:SerialDebugger.Module.ViewModels"
             xmlns:ui="using:AsterDock.UI.Controls"
             x:Class="SerialDebugger.Module.Views.SerialDebuggerView"
             x:CompileBindings="False" Background="{DynamicResource AppPageBrush}">
  <UserControl.Styles>
    <Style Selector="TextBox.console">
      <Setter Property="Background" Value="{DynamicResource AppChromeBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="14"/>
      <Setter Property="FontFamily" Value="Menlo,Consolas,monospace"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="VerticalContentAlignment" Value="Top"/>
    </Style>
    <Style Selector="TabItem"><Setter Property="Padding" Value="18,10"/></Style>
    <Style Selector="ComboBox"><Setter Property="HorizontalAlignment" Value="Stretch"/></Style>
    <Style Selector="ListBox.saved-commands ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
  </UserControl.Styles>
  <UserControl.Resources>
    <DataTemplate x:Key="PortCardTemplate" x:DataType="viewModels:SerialPortSessionViewModel">
      <Border Classes="ad-workspace-card" Padding="16" MinHeight="540">
        <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="12">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border Width="4" Height="20" CornerRadius="2" Background="{Binding AccentBrush}"/>
                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Border Classes="ad-status-badge" Classes.connected="{Binding IsConnected}">
                  <TextBlock Classes="ad-status-text" Classes.connected="{Binding IsConnected}" Text="{Binding ConnectionStatusText}"/>
                </Border>
                <TextBlock Text="{Binding PortSummary}" Foreground="{DynamicResource AppMutedBrush}" VerticalAlignment="Center"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <Button Content="复制配置" Tag="{Binding}" Click="DuplicatePort_Click"/>
                <Button Content="移除" Tag="{Binding}" Click="RemovePort_Click"/>
              </StackPanel>
            </Grid>
            <Grid ColumnDefinitions="*,110,Auto,Auto,90" ColumnSpacing="8">
              <ComboBox Classes="ad-compact" ItemsSource="{Binding AvailablePorts}" SelectedItem="{Binding SelectedPort, Mode=TwoWay}"
                        IsEnabled="{Binding IsDisconnected}" PlaceholderText="选择串口设备" Tag="{Binding}" DropDownOpened="PortComboBox_DropDownOpened">
                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
              <ComboBox Grid.Column="1" Classes="ad-compact" ItemsSource="{Binding BaudRates}" SelectedItem="{Binding BaudRate, Mode=TwoWay}" IsEnabled="{Binding IsDisconnected}" ToolTip.Tip="波特率"/>
              <Button Grid.Column="2" Content="刷新" Tag="{Binding}" Click="RefreshPorts_Click"/>
              <Button Grid.Column="3" Content="参数" Tag="{Binding}" Click="ToggleSettings_Click"/>
              <Button Grid.Column="4" Classes="ad-accent" Content="{Binding ConnectionButtonText}" Tag="{Binding}" IsEnabled="{Binding !IsBusy}" Click="ToggleConnection_Click"/>
            </Grid>
            <Border Classes="ad-section-card" IsVisible="{Binding IsSettingsExpanded}" Padding="10,8">
              <UniformGrid Columns="4" Rows="1">
                <StackPanel Margin="4,0">
                  <TextBlock Text="数据位" FontSize="11" Foreground="{DynamicResource AppMutedBrush}" Margin="0,0,0,4"/>
                  <ComboBox Classes="ad-compact" ItemsSource="{Binding DataBitChoices}" SelectedItem="{Binding DataBits, Mode=TwoWay}" IsEnabled="{Binding IsDisconnected}"/>
                </StackPanel>
                <StackPanel Margin="4,0">
                  <TextBlock Text="停止位" FontSize="11" Foreground="{DynamicResource AppMutedBrush}" Margin="0,0,0,4"/>
                  <ComboBox Classes="ad-compact" ItemsSource="{Binding StopBitChoices}" SelectedItem="{Binding StopBits, Mode=TwoWay}" IsEnabled="{Binding IsDisconnected}"/>
                </StackPanel>
                <StackPanel Margin="4,0">
                  <TextBlock Text="校验位" FontSize="11" Foreground="{DynamicResource AppMutedBrush}" Margin="0,0,0,4"/>
                  <ComboBox Classes="ad-compact" ItemsSource="{Binding ParityChoices}" SelectedItem="{Binding Parity, Mode=TwoWay}" IsEnabled="{Binding IsDisconnected}"/>
                </StackPanel>
                <StackPanel Margin="4,0">
                  <TextBlock Text="流控" FontSize="11" Foreground="{DynamicResource AppMutedBrush}" Margin="0,0,0,4"/>
                  <ComboBox Classes="ad-compact" ItemsSource="{Binding FlowControlChoices}" SelectedItem="{Binding FlowControl, Mode=TwoWay}" IsEnabled="{Binding IsDisconnected}"/>
                </StackPanel>
              </UniformGrid>
            </Border>


          </StackPanel>
          <Grid Grid.Row="1" RowDefinitions="Auto,*" RowSpacing="8">
            <WrapPanel>
              <TextBlock Text="通信日志" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,6"/>
              <Border Classes="ad-segmented" Margin="0,0,12,6">
                <StackPanel Orientation="Horizontal">
                  <Button Classes="ad-segment-item" Classes.selected="{Binding IsTextMode}" Content="文本" Tag="{Binding}" Click="TextMode_Click"/>
                  <Button Classes="ad-segment-item" Classes.selected="{Binding IsHexMode}" Content="HEX" Tag="{Binding}" Click="HexMode_Click"/>
                </StackPanel>
              </Border>
              <CheckBox Content="时间戳" IsChecked="{Binding ShowTimestamp, Mode=TwoWay}" Margin="0,0,12,6"/>
              <CheckBox Content="自动滚动" IsChecked="{Binding AutoScroll, Mode=TwoWay}" Margin="0,0,12,6"/>
              <TextBox Classes="ad-compact" Width="150" Text="{Binding SearchText, Mode=TwoWay}" PlaceholderText="过滤日志内容" Margin="0,0,8,6"/>
              <Button Content="清空日志" Tag="{Binding}" Click="ClearLogs_Click" Margin="0,0,0,6"/>
            </WrapPanel>
            <TextBox Grid.Row="1" Classes="console" Text="{Binding ReceiveText, Mode=OneWay}" Tag="{Binding}"
                     IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
          </Grid>
          <StackPanel Grid.Row="2" Spacing="8">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <WrapPanel>
              <TextBlock Text="发送数据" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,6"/>
              <Border Classes="ad-segmented" Margin="0,0,12,6">
                <StackPanel Orientation="Horizontal">
                  <Button Classes="ad-segment-item" Classes.selected="{Binding IsSendTextMode}" Content="文本" Tag="{Binding}" Click="SendTextMode_Click"/>
                  <Button Classes="ad-segment-item" Classes.selected="{Binding IsSendHexMode}" Content="HEX" Tag="{Binding}" Click="SendHexMode_Click"/>
                </StackPanel>
              </Border>
              <ComboBox Classes="ad-compact" Width="100" ItemsSource="{Binding EncodingChoices}" SelectedItem="{Binding EncodingName, Mode=TwoWay}" ToolTip.Tip="文本编码（收发共用）" Margin="0,0,8,6"/>
              <ComboBox Classes="ad-compact" Width="90" ItemsSource="{Binding LineEndingChoices}" SelectedItem="{Binding LineEnding, Mode=TwoWay}" IsEnabled="{Binding IsSendTextMode}" ToolTip.Tip="文本发送结束符" Margin="0,0,8,6"/>
            </WrapPanel>
              <StackPanel Grid.Column="1" IsVisible="{Binding IsSinglePortFocus}" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <TextBlock Text="快捷指令" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,6"/>
                <TextBox Width="140" Text="{Binding QuickCommandName, Mode=TwoWay}" PlaceholderText="指令名称" Margin="0,0,8,6"/>
                <Button Content="保存当前内容" Tag="{Binding}" Click="SaveQuickCommand_Click" Margin="0,0,0,6" ToolTip.Tip="保存发送区内容与格式；同名覆盖，改名新增"/>
              </StackPanel>
            </Grid>
            <TextBox Classes="console" Height="76" Text="{Binding SendText, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap"
                     PlaceholderText="输入要发送的内容 · Ctrl / ⌘ + Enter 发送" Tag="{Binding}" KeyDown="SendInput_KeyDown"/>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <WrapPanel>
                <CheckBox Content="定时发送" IsChecked="{Binding LoopSendEnabled, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <NumericUpDown Width="125" Minimum="50" Maximum="60000" Increment="50" Value="{Binding CycleIntervalMs, Mode=TwoWay}" FormatString="0" ToolTip.Tip="发送间隔（毫秒），下次启动生效"/>
                <TextBlock Text="毫秒" VerticalAlignment="Center" Margin="6,0" Foreground="{DynamicResource AppMutedBrush}"/>
              </WrapPanel>
              <Button Grid.Column="1" Classes="ad-accent" MinWidth="110" Content="{Binding SendButtonText}" IsEnabled="{Binding CanSend}" Tag="{Binding}" Click="Send_Click"/>
            </Grid>
          </StackPanel>
          <Border Grid.Row="3" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <TextBlock Text="{Binding StatusText}" ToolTip.Tip="{Binding StatusText}" Foreground="{DynamicResource AppMutedBrush}" TextTrimming="CharacterEllipsis"/>
              <TextBlock Grid.Column="1" Text="{Binding StatisticsText}" Foreground="{DynamicResource AppMutedBrush}" FontSize="11"/>
            </Grid>
          </Border>
        </Grid>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="TilePortCardTemplate" x:DataType="viewModels:SerialPortSessionViewModel">
      <Grid Width="{Binding TileWidth}" Height="{Binding WorkspaceHeight}" Margin="0,0,12,0">
        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PortCardTemplate}" Margin="0,0,8,0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
        <Border Width="12" HorizontalAlignment="Right" Background="Transparent" Cursor="SizeWestEast" Tag="{Binding}"
                ToolTip.Tip="拖动调整宽度，双击恢复" PointerPressed="ResizeHandle_PointerPressed" PointerMoved="ResizeHandle_PointerMoved"
                PointerReleased="ResizeHandle_PointerReleased" DoubleTapped="ResizeHandle_DoubleTapped">
          <Border Width="2" Height="48" Background="{DynamicResource AppBorderBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>
  <Grid RowDefinitions="64,Auto,*,Auto">
    <ui:PageHeader Title="串口助手" Subtitle="连接设备，专注收发调试">
      <TextBlock Text="{Binding ConnectedSummary}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource AppMutedBrush}"/>
    </ui:PageHeader>
    <Border Grid.Row="1" Background="{DynamicResource AppSurfaceBrush}" Padding="16,10">
      <WrapPanel>
        <Button Classes="ad-accent" Content="＋ 添加串口" Click="AddPort_Click" Margin="0,0,16,4"/>
        <Border Classes="ad-segmented" Margin="0,0,16,4">
          <StackPanel Orientation="Horizontal">
            <Button Classes="ad-segment-item" Classes.selected="{Binding IsTabLayout}" Content="单口专注" Click="TabLayout_Click"/>
            <Button Classes="ad-segment-item" Classes.selected="{Binding IsTileLayout}" Content="多口对照" Click="TileLayout_Click"/>
          </StackPanel>
        </Border>
        <Button Content="{Binding LinkedButtonText}" Click="ToggleLink_Click" ToolTip.Tip="开启后，同一数据也发送到其他已连接串口" Margin="0,0,8,4"/>
        <Button Content="保存配置" Click="SaveWorkspace_Click" Margin="0,0,0,4"/>
      </WrapPanel>
    </Border>
    <Grid Grid.Row="2" SizeChanged="Workspace_SizeChanged">
      <ScrollViewer x:Name="TileScrollViewer" IsVisible="{Binding IsTileLayout}" Margin="16,12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Sessions}" ItemTemplate="{StaticResource TilePortCardTemplate}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        </ItemsControl>
      </ScrollViewer>
      <TabControl IsVisible="{Binding IsTabLayout}" ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession, Mode=TwoWay}" Margin="16,8,16,12"
                  HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        <TabControl.ItemTemplate>
          <DataTemplate><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{Binding Title}"/><TextBlock Text="{Binding ConnectionStatusText}" FontSize="11" Foreground="{DynamicResource AppMutedBrush}"/></StackPanel></DataTemplate>
        </TabControl.ItemTemplate>
        <TabControl.ContentTemplate>
          <DataTemplate>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="0,12,0,0" SizeChanged="FocusedWorkspace_SizeChanged">
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PortCardTemplate}" Height="{Binding WorkspaceHeight}"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                <Border Grid.Column="1" Classes="ad-workspace-card" Width="280" Height="{Binding WorkspaceHeight}" Margin="12,0,0,0" Padding="14">
                  <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="已保存的指令" FontSize="16" FontWeight="SemiBold"/>
                      <TextBlock Grid.Column="1" Text="{Binding QuickCommands.Count, StringFormat='{}{0} 条'}" Foreground="{DynamicResource AppMutedBrush}" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Grid.Row="1" Text="选择指令后填入左侧发送区" FontSize="11" Foreground="{DynamicResource AppMutedBrush}"/>
                    <Grid Grid.Row="3">
                      <ListBox ItemsSource="{Binding QuickCommands}" SelectedItem="{Binding SelectedQuickCommand, Mode=TwoWay}"
                               Classes="saved-commands" Background="Transparent" BorderThickness="0"
                               ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                          <DataTemplate>
                            <StackPanel Spacing="7" Margin="2,8" ToolTip.Tip="{Binding Payload}">
                              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                              <TextBlock Text="{Binding Payload}" FontFamily="Menlo,Consolas,monospace" FontSize="11"
                                         Foreground="{DynamicResource AppMutedBrush}" TextTrimming="CharacterEllipsis"/>
                              <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="HEX" IsVisible="{Binding IsHexMode}" FontSize="10" Foreground="{DynamicResource AppMutedBrush}"/>
                                <TextBlock Text="文本" IsVisible="{Binding !IsHexMode}" FontSize="10" Foreground="{DynamicResource AppMutedBrush}"/>
                                <TextBlock Text="{Binding EncodingName}" IsVisible="{Binding !IsHexMode}" FontSize="10" Foreground="{DynamicResource AppMutedBrush}"/>
                              </StackPanel>
                            </StackPanel>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>
                      <TextBlock Text="还没有保存的指令。&#10;在发送区输入内容并命名保存。" IsVisible="{Binding !QuickCommands.Count}" TextWrapping="Wrap"
                                 Foreground="{DynamicResource AppMutedBrush}" Margin="8,16" IsHitTestVisible="False"/>
                    </Grid>
                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <Button Classes="ad-accent" Content="填入发送区" HorizontalAlignment="Stretch" IsEnabled="{Binding HasSelectedQuickCommand}" Tag="{Binding}" Click="LoadQuickCommand_Click"/>
                      <Button Grid.Column="1" Content="删除" IsEnabled="{Binding HasSelectedQuickCommand}" Tag="{Binding}" Click="RemoveQuickCommand_Click"/>
                    </Grid>
                  </Grid>
                </Border>
              </Grid>
            </ScrollViewer>
          </DataTemplate>
        </TabControl.ContentTemplate>
      </TabControl>
    </Grid>
    <TextBlock Grid.Row="3" Text="{Binding WorkspaceStatus}" Margin="18,0,18,10" FontSize="11" Foreground="{DynamicResource AppMutedBrush}" TextTrimming="CharacterEllipsis"/>
  </Grid>
</UserControl>
