<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="VMCube.Module.Views.ConsoleWindow"
        x:CompileBindings="False"
        Width="1280" Height="800" MinWidth="640" MinHeight="440"
        Background="{DynamicResource AppPageBrush}"
        FontFamily="Microsoft YaHei, PingFang SC, Noto Sans CJK SC, Segoe UI">
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Background="{DynamicResource AppChromeBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1">
      <Grid Margin="16,10" ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="12">
        <TextBlock x:Name="status" Text="正在连接…" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource AppStrongTextBrush}"/>
        <Button x:Name="ConsoleSendFiles" Grid.Column="1" Classes="ad-icon" ToolTip.Tip="发送文件到虚拟机" AutomationProperties.Name="发送文件到虚拟机" IsVisible="False" IsEnabled="False" Click="Upload_Click">
          <Path Width="18" Height="18" Stretch="Uniform" StrokeThickness="1.5" Stroke="{DynamicResource AppStrongTextBrush}" Data="M12,16 V3 M7,8 L12,3 L17,8 M3,15 V21 H21 V15"/>
        </Button>
        <Button x:Name="secureAttention" Grid.Column="2" Content="Ctrl + Alt + Del" VerticalAlignment="Center" Click="Secure_Click"/>
        <Button x:Name="fullScreen" Grid.Column="3" Content="全屏" VerticalAlignment="Center" Click="FullScreen_Click"/>
        <Button x:Name="disconnect" Grid.Column="4" Content="断开连接" VerticalAlignment="Center" Click="Disconnect_Click"/>
      </Grid>
    </Border>
    <Border Grid.Row="1" Background="Black">
      <Image x:Name="desktop" Stretch="Uniform" Focusable="True"/>
    </Border>
    <Border Grid.Row="2" Background="{DynamicResource AppChromeBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0">
      <StackPanel>
        <Grid x:Name="fileBar" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="16,6,16,0" IsVisible="False">
          <StackPanel Spacing="6" VerticalAlignment="Center">
            <TextBlock x:Name="ConsoleFileStatus" FontSize="12" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" Classes="ad-muted"/>
            <ProgressBar x:Name="fileProgress" Minimum="0" Maximum="100" Height="4" IsVisible="False"/>
          </StackPanel>
          <Button x:Name="ConsoleCancelFiles" Grid.Column="1" Classes="ad-icon" ToolTip.Tip="取消发送" AutomationProperties.Name="取消发送" IsVisible="False" Click="CancelFiles_Click">
            <Path Width="18" Height="18" Stretch="Uniform" StrokeThickness="1.5" Stroke="{DynamicResource AppStrongTextBrush}" Data="M5,5 L19,19 M19,5 L5,19"/>
          </Button>
          <Button x:Name="ConsoleFileHelp" Grid.Column="2" Classes="ad-icon" ToolTip.Tip="文件传输配置说明" AutomationProperties.Name="文件传输配置说明" Click="FileHelp_Click">
            <Path Width="18" Height="18" Stretch="Uniform" StrokeThickness="1.5" Stroke="{DynamicResource AppStrongTextBrush}" Data="M12,2 A10,10 0 1 1 11.99,2 M12,10 V17 M12,6 V7"/>
          </Button>
        </Grid>
        <TextBlock Text="点击画面控制 · Ctrl + Alt + Esc 释放键鼠 · 关闭窗口断开连接" Classes="ad-muted" FontSize="12" Margin="16,8"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
