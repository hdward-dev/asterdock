<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/AsterDock.Contracts/AsterDock.Contracts.csproj" />
    <ProjectReference Include="../../src/AsterDock.UI/AsterDock.UI.csproj" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.0" />
    <Compile Include="../../src/AsterDock.Host/Modules/AppModuleLoadContext.cs" Link="AppModuleLoadContext.cs" />
  </ItemGroup>
  <!-- 不引用模块，确保检查宿主只使用 Microsoft.NETCore.App。 -->
  <Target Name="BuildFileShareModule" BeforeTargets="BeforeBuild">
    <MSBuild Projects="../../src/FileShare.Module/FileShare.Module.csproj" Targets="Restore;Build"
             Properties="Configuration=$(Configuration)" RemoveProperties="RuntimeIdentifier;SelfContained" />
  </Target>
</Project>
